import formatCommaSeparatedCss from "@/utils/formatCommaSeparatedCss";
import { roomViewOverflowClass } from "@/views/RoomView.css";
import {
  createVar,
  globalStyle,
  style,
  type StyleRule,
} from "@vanilla-extract/css";
import { nanoid } from "nanoid";

export const transitionGroupName = `cards-${nanoid()}`;
export const defaultTransitionDuration = "350ms";

const transitionDuration = createVar();
const opacityTransitionDuration = createVar();

const transitionTimingFn = "var(--transition-timing-function-fast-out-slow-in)";

const opacityTransitionConfig = `${opacityTransitionDuration} ${transitionTimingFn}`;
const transitionConfig = `${transitionDuration} ${transitionTimingFn}`;

export const cardsGap = "1rem";
export const cards = style([
  roomViewOverflowClass,
  {
    position: "relative",
    width: "100%",
    height: "100%",
    maxHeight: "100%",
    vars: {
      [transitionDuration]: defaultTransitionDuration,
      [opacityTransitionDuration]: defaultTransitionDuration,
    },

    selectors: {
      '&[data-instant-transition="true"]': {
        vars: {
          [transitionDuration]: "0ms",
          [opacityTransitionDuration]: "0ms",
        },
      },
    },

    "@media": {
      "(prefers-reduced-motion: reduce)": {
        vars: {
          [transitionDuration]: "0ms",
        },
      },
    },
  },
]);

const liContainerName = "room-member-card-li";
export const li = style({
  position: "relative",
  containerName: liContainerName,
  containerType: "inline-size",
  willChange: "transform, opacity, max-width, max-height",
});

const initVisibleState: StyleRule = {
  transform: "scale(0.8)",
  opacity: 0,
} as const;

globalStyle(`.${cards}[data-resizing="true"] .${transitionGroupName}-move`, {
  transition: "none !important",
});

globalStyle(`.${transitionGroupName}-move`, {
  zIndex: 1,
  transition: formatCommaSeparatedCss(`
    transform ${transitionConfig},
    max-width ${transitionConfig},
    max-height ${transitionConfig}
  `),
});

globalStyle(`.${transitionGroupName}-enter-active`, {
  transition: formatCommaSeparatedCss(`
    opacity ${opacityTransitionDuration},
    all ${transitionConfig}
  `),
});

globalStyle(`.${transitionGroupName}-enter-from`, initVisibleState);
globalStyle(`.${transitionGroupName}-leave-active`, {
  position: "absolute",
  pointerEvents: "none",
  width: "0 !important",
  height: "0 !important",
  margin: "0 !important",
  padding: "0 !important",
  zIndex: 0,
  overflow: "hidden",
  transition: formatCommaSeparatedCss(`
    opacity ${opacityTransitionDuration},
    transform ${transitionConfig}
  `),
});

globalStyle(`.${transitionGroupName}-leave-to`, initVisibleState);
