{
  "name": "@speak-up/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "imports": {
    "#cleanup/*": "./cleanup/*",
    "#controllers/*": "./controllers/*",
    "#dtos/*": "./dtos/*",
    "#errors/*": "./errors/*",
    "#events/*": "./events/*",
    "#generated/*": "./generated/*",
    "#middlewares/*": "./middlewares/*",
    "#router/*": "./router/*",
    "#services/*": "./services/*",
    "#tests/*": "./tests/*",
    "#types/*": "./types/*",
    "#utils/*": "./utils/*",
    "#validators/*": "./validators/*"
  },
  "scripts": {
    "build": "prisma generate && tsup",
    "start": "node dist/index.js",
    "dev": "nodemon --exec tsx index.ts",
    "lint": "eslint .",
    "test:unit": "dotenv -e .env.test -- vitest run --dir tests/unit",
    "test:api": "dotenv -e .env.test -- prisma db push && dotenv -e .env.test -- vitest run --dir tests/api",
    "test:api:preview": "dotenv -e .env.test -- prisma db push",
    "test:socket": "dotenv -e .env.test -- vitest run --dir tests/socket",
    "test:socket-api": "dotenv -e .env.test -- prisma db push && dotenv -e .env.test -- vitest run --dir tests/socketApi"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@prisma/client": "6.19",
    "@speak-up/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "nanoid": "^5.1.11",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.4",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.11",
    "prisma": "6.19",
    "shared": "^0.2.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@10.32.1"
}
